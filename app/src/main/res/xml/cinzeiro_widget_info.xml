<?xml version="1.0" encoding="utf-8"?>
<!-- 2×1: today's count, "último HH:MM" and "+1". No updatePeriodMillis: updates on each event and at midnight (WorkManager).
     R5: direct RemoteViews (layout/widget_smoke), no Glance. Same file and same receiver as 0.5.1,
     so the widget already placed survives the update. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_smoke"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
